rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only admins can upload APKs, icons, and banners
    match /apks/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'abnormaleditz80@gmail.com' ||
        request.auth.token.email == 'insilent345@gmail.com'
      );
    }
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'abnormaleditz80@gmail.com' ||
        request.auth.token.email == 'insilent345@gmail.com'
      );
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
